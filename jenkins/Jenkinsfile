pipeline {
    agent any

    environment {
    AWS_DEFAULT_REGION    = 'ap-south-1'
    TF_DIR                = 'terraform/environments/dev'
    ANSIBLE_DIR           = 'ansible'
    AWS_ACCESS_KEY_ID     = credentials('Access_key')
    AWS_SECRET_ACCESS_KEY = credentials('Secret_key')
    TF_VAR_key_name       = 'key mumbai'
    TF_VAR_admin_cidrs    = '["103.175.136.131/32"]'
}
    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir(TF_DIR) {
                    sh 'terraform init -input=false'
                    sh 'terraform workspace select dev || terraform workspace new dev'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir(TF_DIR) {
                    sh 'terraform plan -input=false -out=tfplan'
                }
            }
        }

        stage('Manual Approval') {
            steps {
                input message: 'Review the Terraform plan above. Apply infrastructure changes?', ok: 'Apply'
            }
        }

        stage('Terraform Apply') {
            steps {
                dir(TF_DIR) {
                    sh 'terraform apply -input=false -auto-approve tfplan'
                }
            }
        }
stage('Generate Ansible Config') {
    steps {
        dir(TF_DIR) {
            script {
                env.BASTION_IP = sh(script: "terraform output -raw bastion_public_ip", returnStdout: true).trim()
            }
        }
    }
}
        stage('Ansible: Install Requirements') {
            steps {
                dir(ANSIBLE_DIR) {
                    sh 'ansible-galaxy collection install -r requirements.yml'
                }
            }
        }

        stage('Run Ansible Playbooks') {
            steps {
                dir(ANSIBLE_DIR) {
                    sh 'ansible-playbook playbook.yml'
                }
            }
        }

       stage('Verify Infrastructure') {
    steps {
        dir(TF_DIR) {
            sh '''
                echo "bastion reachable (Jenkins is running on it)"
                for ip in $(terraform output -json private_node_ips | python3 -c "import sys,json; print(' '.join(json.load(sys.stdin).values()))"); do
                  ssh -o StrictHostKeyChecking=no -i ~/.ssh/key-mumbai.pem ubuntu@$ip "curl -sf http://localhost/health" || echo "WARN: $ip health check failed"
                done
            '''
        }
    }
}

    post {
        success {
            echo 'Infrastructure provisioned, configured, and verified successfully.'
        }
        failure {
            echo 'Pipeline failed - infrastructure was NOT fully verified. Check logs above.'
        }
    }
}
